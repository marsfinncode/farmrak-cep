<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="32dp">

        <FrameLayout
            android:id="@+id/splashIconWrap"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:background="@drawable/bg_splash_icon"
            android:layout_marginBottom="22dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_sprout"
                android:contentDescription="@string/app_name" />
        </FrameLayout>

        <TextView
            android:id="@+id/splashTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:gravity="center"
            android:fontFamily="@font/sarabun_bold"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/splashSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ระบบรดน้ำ &amp; ให้ปุ๋ยอัตโนมัติ\nสำหรับเกษตรกร"
            android:textColor="@color/splash_sub_text"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginBottom="14dp" />

        <TextView
            android:id="@+id/splashProgram"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/community_program_label"
            android:textColor="@color/sprout"
            android:textSize="12sp"
            android:fontFamily="@font/sarabun_semibold"
            android:background="@drawable/bg_pill_soft"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:layout_marginBottom="30dp" />

        <ProgressBar
            android:id="@+id/splashProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="150dp"
            android:layout_height="4dp"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/progress_splash" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/splashBottomGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="26dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:src="@drawable/logo_program"
            android:adjustViewBounds="true"
            android:alpha="0.95"
            android:layout_marginBottom="10dp"
            android:contentDescription="@string/community_program_label" />

        <TextView
            android:id="@+id/splashSkip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="แตะที่หน้าจอเพื่อข้าม"
            android:textColor="@color/splash_skip_text"
            android:textSize="12sp" />
    </LinearLayout>

</FrameLayout>
