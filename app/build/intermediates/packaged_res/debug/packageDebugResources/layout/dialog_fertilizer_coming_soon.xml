<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_avatar_placeholder"
        android:layout_marginBottom="16dp" />

    <!-- Top Badge / Header Icon -->
    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_avatar_placeholder"
        android:backgroundTint="@color/leaf_card"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_fertilizer_flask"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/fert_coming_soon_title"
        android:textColor="@color/ink"
        android:fontFamily="@font/sarabun_bold"
        android:textStyle="bold"
        android:textSize="20sp"
        android:gravity="center" />

    <!-- Phase Badge -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp"
        android:text="@string/fert_coming_soon_badge"
        android:textColor="@color/amber_text"
        android:background="@drawable/bg_pill_soft"
        android:backgroundTint="@color/amber_card"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:fontFamily="@font/sarabun_semibold"
        android:textSize="12sp" />

    <!-- Description -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/fert_coming_soon_sub"
        android:textColor="@color/ink_soft"
        android:fontFamily="@font/sarabun_regular"
        android:textSize="13.5sp"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- Point 1: Hardware Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_card_rounded"
        android:backgroundTint="@color/water_card"
        android:padding="14dp"
        android:layout_marginBottom="10dp">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_avatar_placeholder"
            android:backgroundTint="@color/surface"
            android:layout_marginEnd="12dp"
            android:layout_gravity="top">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_tools"
                android:contentDescription="@null" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fert_coming_soon_point1_title"
                android:textColor="@color/ink"
                android:fontFamily="@font/sarabun_semibold"
                android:textSize="13.5sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fert_coming_soon_point1_desc"
                android:textColor="@color/ink_soft"
                android:fontFamily="@font/sarabun_regular"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Point 2: Future Plan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_card_rounded"
        android:backgroundTint="@color/leaf_card"
        android:padding="14dp"
        android:layout_marginBottom="10dp">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_avatar_placeholder"
            android:backgroundTint="@color/surface"
            android:layout_marginEnd="12dp"
            android:layout_gravity="top">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_sprout"
                android:contentDescription="@null" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fert_coming_soon_point2_title"
                android:textColor="@color/ink"
                android:fontFamily="@font/sarabun_semibold"
                android:textSize="13.5sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fert_coming_soon_point2_desc"
                android:textColor="@color/ink_soft"
                android:fontFamily="@font/sarabun_regular"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Point 3: Farming Recommendation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_card_rounded"
        android:backgroundTint="@color/amber_card"
        android:padding="14dp"
        android:layout_marginBottom="22dp">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_avatar_placeholder"
            android:backgroundTint="@color/surface"
            android:layout_marginEnd="12dp"
            android:layout_gravity="top">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_book"
                android:contentDescription="@null" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fert_coming_soon_point3_title"
                android:textColor="@color/ink"
                android:fontFamily="@font/sarabun_semibold"
                android:textSize="13.5sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fert_coming_soon_point3_desc"
                android:textColor="@color/ink_soft"
                android:fontFamily="@font/sarabun_regular"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Dismiss Button -->
    <Button
        android:id="@+id/btnGotItFertilizer"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/fert_coming_soon_got_it"
        android:textAllCaps="false"
        android:fontFamily="@font/sarabun_semibold"
        android:textSize="15sp"
        android:textColor="@color/paper"
        android:backgroundTint="@color/leaf" />

</LinearLayout>
