<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <!-- ===================== LIST VIEW ===================== -->
    <LinearLayout
        android:id="@+id/plantListContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/plants_title"
            android:textColor="@color/ink"
            android:textSize="20sp"
            android:fontFamily="@font/sarabun_bold"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/plants_sub"
            android:textColor="@color/ink_soft"
            android:textSize="13sp"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/etSearchPlant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:backgroundTint="@color/surface"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:hint="@string/search_plant_hint"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_soft"
            android:inputType="text"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:layout_marginBottom="14dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerPlants"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/tvNoResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/plants_no_results"
            android:textColor="@color/ink_soft"
            android:textSize="13.5sp"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ===================== DETAIL VIEW ===================== -->
    <ScrollView
        android:id="@+id/plantDetailContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_back_arrow"
                    android:background="@drawable/bg_avatar_placeholder"
                    android:backgroundTint="@color/surface"
                android:foreground="?attr/selectableItemBackground"
                android:clipToOutline="true"
                    android:contentDescription="@string/back" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/btnEditPlant"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_edit"
                    android:background="@drawable/bg_avatar_placeholder"
                    android:backgroundTint="@color/surface"
                android:foreground="?attr/selectableItemBackground"
                android:clipToOutline="true"
                    android:layout_marginEnd="10dp"
                    android:visibility="gone"
                    android:contentDescription="@string/edit_plant_title" />

                <ImageView
                    android:id="@+id/btnDeletePlant"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_delete"
                    android:background="@drawable/bg_avatar_placeholder"
                    android:backgroundTint="@color/surface"
                android:foreground="?attr/selectableItemBackground"
                android:clipToOutline="true"
                    android:visibility="gone"
                    android:contentDescription="@string/delete_plant" />
            </LinearLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgDetailPhoto"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/RoundedImageStyle"
                android:layout_marginBottom="16dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvDetailName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:fontFamily="@font/sarabun_bold"
            android:textStyle="bold"
                android:textSize="22sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvDetailScientific"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink_soft"
                android:textStyle="italic"
                android:textSize="13.5sp"
                android:gravity="center"
                android:layout_marginBottom="18dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/plant_characteristics_title"
                android:textColor="@color/ink"
                android:fontFamily="@font/sarabun_semibold"
                android:textSize="14.5sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink_soft"
                android:textSize="13.5sp"
                android:lineSpacingMultiplier="1.35"
                android:layout_marginBottom="18dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded"
                android:backgroundTint="@color/leaf_card"
                android:padding="16dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/plant_ph_label"
                    android:textColor="@color/leaf_deep"
                    android:fontFamily="@font/sarabun_semibold"
                    android:textSize="13.5sp" />

                <TextView
                    android:id="@+id/tvDetailPh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:textColor="@color/ink"
                    android:textSize="20sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded"
                android:backgroundTint="@color/water_card"
                android:padding="16dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/plant_moisture_label"
                    android:textColor="@color/water"
                    android:fontFamily="@font/sarabun_semibold"
                    android:textSize="13.5sp" />

                <TextView
                    android:id="@+id/tvDetailMoisture"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:textColor="@color/ink"
                    android:textSize="20sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded"
                android:backgroundTint="@color/amber_card"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/plant_fertilizer_label"
                    android:textColor="@color/amber_text"
                    android:fontFamily="@font/sarabun_semibold"
                    android:textSize="13.5sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvDetailFertilizer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink"
                    android:textSize="13.5sp"
                    android:lineSpacingMultiplier="1.3" />
            </LinearLayout>

            <View
                android:id="@+id/referencesDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/line"
                android:layout_marginBottom="14dp" />

            <TextView
                android:id="@+id/tvReferencesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/plant_references_title"
                android:textColor="@color/ink_soft"
                android:fontFamily="@font/sarabun_semibold"
                android:textSize="12.5sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/referencesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" android:animateLayoutChanges="true" />

        </LinearLayout>
    </ScrollView>

    <!-- ===================== ADD / EDIT FORM ===================== -->
    <ScrollView
        android:id="@+id/plantFormContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <ImageView
                android:id="@+id/btnCancelForm"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/ic_back_arrow"
                android:background="@drawable/bg_avatar_placeholder"
                android:backgroundTint="@color/surface"
                android:foreground="?attr/selectableItemBackground"
                android:clipToOutline="true"
                android:layout_marginBottom="14dp"
                android:contentDescription="@string/cancel" />

            <TextView
                android:id="@+id/tvFormTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/add_plant_title"
                android:textColor="@color/ink"
                android:fontFamily="@font/sarabun_bold"
            android:textStyle="bold"
                android:textSize="19sp"
                android:layout_marginBottom="18dp" />

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="20dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgFormPhoto"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:background="@drawable/bg_avatar_placeholder"
                    android:foreground="?attr/selectableItemBackground"
                    android:clipToOutline="true"
                    android:padding="26dp"
                    android:src="@drawable/ic_person_placeholder"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/CircleImageStyle"
                    android:contentDescription="@string/tap_to_add_photo" />

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="bottom|end"
                    android:padding="6dp"
                    android:background="@drawable/bg_avatar_placeholder"
                    android:backgroundTint="@color/leaf_deep"
                    android:src="@drawable/ic_camera_badge"
                    android:contentDescription="@null" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded"
                android:backgroundTint="@color/surface"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/plant_name_field_label"
                    android:textColor="@color/ink"
                    android:fontFamily="@font/sarabun_semibold"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etFormName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/plant_name_field_hint"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_soft"
                    android:inputType="text"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/plant_scientific_field_label"
                    android:textColor="@color/ink"
                    android:fontFamily="@font/sarabun_semibold"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etFormScientific"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/plant_scientific_field_hint"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_soft"
                    android:inputType="text"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilFormCategory"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/plant_category_field_label"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/actFormCategory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textColor="@color/ink" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/plant_description_field_label"
                    android:textColor="@color/ink"
                    android:fontFamily="@font/sarabun_semibold"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etFormDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/plant_description_field_hint"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_soft"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:gravity="top"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/plant_ph_range_label"
                    android:textColor="@color/ink"
                    android:fontFamily="@font/sarabun_semibold"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <EditText
                        android:id="@+id/etFormPhMin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:hint="@string/plant_min_hint"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/ink_soft"
                        android:inputType="numberDecimal" />

                    <EditText
                        android:id="@+id/etFormPhMax"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:hint="@string/plant_max_hint"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/ink_soft"
                        android:inputType="numberDecimal" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/plant_moisture_range_label"
                    android:textColor="@color/ink"
                    android:fontFamily="@font/sarabun_semibold"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <EditText
                        android:id="@+id/etFormMoistureMin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:hint="@string/plant_min_hint"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/ink_soft"
                        android:inputType="number" />

                    <EditText
                        android:id="@+id/etFormMoistureMax"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:hint="@string/plant_max_hint"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/ink_soft"
                        android:inputType="number" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/plant_fertilizer_field_label"
                    android:textColor="@color/ink"
                    android:fontFamily="@font/sarabun_semibold"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etFormFertilizer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/plant_fertilizer_field_hint"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_soft"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:gravity="top"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSavePlant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/save_plant"
                android:textAllCaps="false"
                android:fontFamily="@font/sarabun_semibold"
                android:textColor="@color/paper"
                android:backgroundTint="@color/leaf"
                android:layout_marginTop="18dp" />

            <Button
                android:id="@+id/btnDeletePlantForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/delete_plant"
                android:textAllCaps="false"
                android:fontFamily="@font/sarabun_semibold"
                android:textColor="@color/rust"
                android:backgroundTint="@color/amber_card"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <!-- ===================== FLOATING ADD BUTTON ===================== -->
    <LinearLayout
        android:id="@+id/fabAddPlant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="22dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_pill_solid"
        android:foreground="?attr/selectableItemBackground"
        android:clipToOutline="true"
        android:paddingHorizontal="18dp"
        android:paddingVertical="14dp"
        android:elevation="6dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_plus"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_new_plant"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/sarabun_semibold"
            android:textSize="13.5sp" />
    </LinearLayout>

</FrameLayout>
